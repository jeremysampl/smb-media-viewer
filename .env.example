# Copy to .env next to docker-compose.yml and set strong secrets.
# Never commit the real .env file.

JWT_SECRET=change-me-in-production
TOKEN_SECRET=change-me-token-secret

# URL users open in the browser (include scheme + port if not 443/80).
FRONTEND_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080

# true only when the site is served over HTTPS (Secure cookies).
# If unset, derived from FRONTEND_ORIGIN (https → secure cookies).
# For typical LAN http://nas:8080, leave unset or set false.
# COOKIE_SECURE=false

# Image tag from GHCR (latest, or a release like 1.0.0).
IMAGE_TAG=latest

# Backend resource limits (Docker cgroups). Defaults suit a Raspberry Pi.
# Memory values accept Docker sizes: 512m, 1g, etc.
BACKEND_MEM_LIMIT=2g
BACKEND_CPUS=1.0
# Node.js heap cap in MiB — keep below BACKEND_MEM_LIMIT (native sharp/ffmpeg needs headroom).
BACKEND_NODE_MAX_OLD_SPACE_MB=1536

# Optional: transcode cache size cap (bytes). Default 10 GiB.
# CACHE_MAX_BYTES=10737418240

# Parallel index/thumb jobs (Sharp + ffmpeg + EXIF). Default 2.
# Lower to 1 on a Raspberry Pi if large folders still overload the CPU.
# INDEX_CONCURRENCY=2
