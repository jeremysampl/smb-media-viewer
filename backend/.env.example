PORT=3001
JWT_SECRET=change-me-in-production
TOKEN_SECRET=change-me-token-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=smb_media_token
LOCAL_DEV=false
DEV_SHARE_NAME=media
DEV_MEDIA_ROOT=./dev-media
SMB_CONF_PATH=/etc/samba/smb.conf
GROUP_FILE_PATH=/etc/group
PASSWD_FILE_PATH=/etc/passwd
SMB_HOST=localhost
MEDIA_ROOT=/srv
CACHE_DIR=/app/cache
CACHE_MAX_BYTES=10737418240
CACHE_CLEANUP_CRON=0 */6 * * *
INDEX_DIR=/app/index
# Parallel Sharp/ffmpeg/EXIF jobs (default 2). Use 1 on Raspberry Pi if needed.
INDEX_CONCURRENCY=2
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Comma-separated Samba usernames that can open /admin (case-insensitive).
# ADMIN_USERS=alice,bob
