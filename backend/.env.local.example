# Copy to .env for local development on your machine
LOCAL_DEV=true
PORT=3001
JWT_SECRET=local-dev-secret
TOKEN_SECRET=local-dev-token-secret
DEV_SHARE_NAME=media
DEV_MEDIA_ROOT=./dev-media
SMB_HOST=localhost
FRONTEND_ORIGIN=http://localhost:5173
CACHE_DIR=./cache
INDEX_DIR=./index

# Optional: validate login against your real NAS while browsing a mapped share
# SMB_HOST=192.168.1.50
# DEV_MEDIA_ROOT=Z:/photos
